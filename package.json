{
  "name": "acp-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendor-agnostic attention-ranked workspace for AI coding agents via Agent Client Protocol (ACP)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/cli.ts",
    "dev:web": "vite",
    "start": "tsx server/cli.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "test": "NODE_ENV=test tsx scripts/test-acp.ts",
    "smoke": "NODE_ENV=test tsx scripts/smoke.ts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "@agentclientprotocol/sdk": "^1.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.2",
    "marked": "^18.0.14",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.12"
  }
}
